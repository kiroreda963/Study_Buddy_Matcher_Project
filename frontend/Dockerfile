FROM node:20 AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_AUTH_API_URI
ARG VITE_PROFILE_API_URI
ARG VITE_AVAILABILITY_API_URI
ARG VITE_NOTIFICATION_API_URI
ARG VITE_SESSION_API_URI
ARG VITE_MATCHING_API_URI
ARG VITE_API_HOST

RUN VITE_AUTH_API_URI=$VITE_AUTH_API_URI \
    VITE_PROFILE_API_URI=$VITE_PROFILE_API_URI \
    VITE_AVAILABILITY_API_URI=$VITE_AVAILABILITY_API_URI \
    VITE_NOTIFICATION_API_URI=$VITE_NOTIFICATION_API_URI \
    VITE_SESSION_API_URI=$VITE_SESSION_API_URI \
    VITE_MATCHING_API_URI=$VITE_MATCHING_API_URI \
    VITE_API_HOST=$VITE_API_HOST \
    npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]